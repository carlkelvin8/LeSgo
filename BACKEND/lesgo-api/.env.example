APP_NAME="LeSGo API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
MAX_JSON_BODY_BYTES=2097152

CORS_ALLOWED_ORIGINS=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ================
# DATABASE
# ================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lesgo_api
DB_USERNAME=postgres
DB_PASSWORD=

# =====================
# SESSION / CACHE / QUEUE
# =====================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# =====================
# REVERB (WebSocket)
# =====================
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# =========
# MAIL
# =========
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@lesgo.ph
MAIL_FROM_NAME="LeSGo"

# =========
# Google
# =========
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# =========
# Firebase
# =========
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=

# =========
# Twilio (SMS)
# =========
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
OTP_ALLOW_LOCAL_FALLBACK=false

# =========
# Semaphore (SMS fallback)
# =========
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=LESGO

# =========
# Payment gateways
# =========
LESPAY_DEFAULT_GATEWAY=paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_URL=
PAYMONGO_WALLET_ACCOUNT_NUMBER=
PAYMONGO_WALLET_ACCOUNT_NAME="LeSGo Platform"
PAYMONGO_GCASH_BIC=GXCHPHM2XXX
PAYMONGO_MAYA_BIC=PAPHPHM1XXX
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# =========
# AWS S3
# =========
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =========
# PayMongo (Mission reward reimbursements & wallet)
# =========
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=lesgo://lespay/topup/success
PAYMONGO_FAILURE_URL=lesgo://lespay/topup/failure
PAYMONGO_WALLET_ACCOUNT_NUMBER=
PAYMONGO_WALLET_ACCOUNT_NAME=LeSGo Platform
PAYMONGO_WALLET_BIC=PAEYPHM2XXX
PAYMONGO_WEBHOOK_URL=${APP_URL}/api/v1/webhooks/payments/paymongo

# =========
# Xendit (fallback gateway)
# =========
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=
