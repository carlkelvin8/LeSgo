APP_NAME="LesGo Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Required for admin-triggered user password-reset OTPs. Use the API base URL
# for the same environment/database, e.g. https://api.lesgo.ph/api in production.
LESGO_API_BASE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# IMPORTANT: The admin panel operates on the SAME database as the LesGo API.
# Approvals, waivers, and rejections written here must be visible to the API's
# registration-fee logic, so DB_CONNECTION must match the API's production
# database (PostgreSQL), NOT a separate MySQL instance.
#
# Local development:
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lesgo_api
DB_USERNAME=postgres
DB_PASSWORD=

# Production (laravel.cloud example — copy the values from the API's .env):
# DB_CONNECTION=pgsql
# DB_HOST=ep-xxxx.c-2.aws-ap-southeast-1.pg.laravel.cloud
# DB_PORT=5432
# DB_DATABASE=lesgo_api
# DB_USERNAME=lesgo_api
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Required when seeding an administrator in production.
ADMIN_EMAIL=admin@lesgo.com
ADMIN_NAME="LesGo Admin"
ADMIN_ROLE=super_admin
ADMIN_PASSWORD=

# Firebase HTTP v1: use either a service-account file path or its base64 JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FIREBASE_CREDENTIALS_BASE64=

# Provider-neutral SMS webhook. The endpoint receives to/title/message/data.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PayMongo (read-only monitoring — secret never exposed to frontend)
PAYMONGO_WALLET_ACCOUNT_NUMBER=
PAYMONGO_WALLET_ACCOUNT_NAME=LeSGo Platform
PAYMONGO_WEBHOOK_URL=${APP_URL}/api/v1/webhooks/payments/paymongo

VITE_APP_NAME="${APP_NAME}"
